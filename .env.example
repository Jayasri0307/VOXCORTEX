# ==========================================
# VOXCORTEX AI - ENVIRONMENT CONFIGURATION
# ==========================================
# Add these in Vercel Project Settings > Environment Variables
# or copy to backend/.env for local development.

# --- Lyzr Multi-Agent System ---
# Obtain from Lyzr Studio (https://studio.lyzr.ai)
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_MANAGER_AGENT_ID=your_manager_agent_id_here
LYZR_SUMMARIZER_AGENT_ID=your_summarizer_agent_id_here
LYZR_TASK_AGENT_ID=your_task_agent_id_here
LYZR_MEMORY_AGENT_ID=your_memory_agent_id_here

# --- AI Memory Vault (Qdrant Vector Cloud) ---
# Obtain from Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=mindflow_memories

# --- Embedding Provider ---
# Options: "fastembed" (default: free, local, 384-dim BAAI/bge-small-en-v1.5)
EMBEDDING_PROVIDER=fastembed

# --- Mobile Voice Webhook ---
OMI_WEBHOOK_SECRET=

# --- Server & Environment ---
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=production
